rules_version = '2';

// The database is fully locked to browsers. Every read and write goes through
// the app's server (Admin SDK), which verifies identity and role on each call.
// This one rule is the backstop that makes client-side tampering impossible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
