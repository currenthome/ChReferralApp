# Copy to .env.local for local dev. In production these live in Vercel project settings.
# NEXT_PUBLIC_ values are safe to expose; everything else is secret.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=current-home-referrals.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=current-home-referrals

# Full JSON (or base64) of the Firebase service account key. SECRET.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated emails that always get manager access (bootstrap).
ADMIN_EMAILS=justin.black@currenthome.com

# Random string; Vercel sends it with cron requests so only Vercel can trigger the daily job.
CRON_SECRET=

# Recruiting side (v2). While V2_ENABLED is false, only the emails listed below can
# reach recruiting — and they still need a level set on their user record. Flip
# V2_ENABLED to true at launch and the allow-list stops mattering.
V2_ENABLED=false
V2_PREVIEW_EMAILS=justin.black@currenthome.com,skip@currenthome.com

# Gmail sending (optional until notifications go live): a currenthome.com mailbox + app password.
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=Current Home Referrals <referrals@currenthome.com>
